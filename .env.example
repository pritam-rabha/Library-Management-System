# Copy this file to .env and fill in the values. Never commit the real .env file.

# "development" for local use, "production" on Render.
APP_ENV=development

# Required in production. Generate with:
#   python scripts/generate_credentials.py --secret
SECRET_KEY=46c8d364565d631b15632d40f40db24390962002b5e9d784f623fe168f1e20be

# Administrator account. Generate the hash with:
#   python scripts/generate_credentials.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2:sha256:1000000$OTxAbMM2dv5wJlkE$e5a54f86ba4d922d119fe9bbdc88cdd39fa68bee601e20cf391e14a8c3ee1baa

# Optional settings (defaults shown). The fine rate, loan period and loan limit
# are only used to create a brand-new data file; afterwards change them on the Settings page.
FINE_PER_DAY=2.00
LOAN_DAYS=14
MAX_LOANS_PER_MEMBER=5
CURRENCY_SYMBOL=₹
TIMEZONE=Asia/Kolkata

# Load the fictional sample books, members and loans when the data file is first created.
SEED_SAMPLE_DATA=true

# Session lifetime in minutes, and login throttling.
SESSION_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300

# Optional: where the runtime JSON data is stored.
# DATA_FILE=data/runtime/library.json
